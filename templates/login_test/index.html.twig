{% extends 'base.html.twig' %}

{% block title %}Login Test{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card">
                <div class="card-header bg-warning">
                    <h1 class="h3 mb-0">Login Test - Error Demonstration</h1>
                </div>
                <div class="card-body">
                    {% if error %}
                        <div class="alert alert-danger">
                            <h4>Authentication Error:</h4>
                            <strong>{{ error.messageKey|trans(error.messageData, 'security') }}</strong>
                            <hr>
                            <small>Message Key: {{ error.messageKey }}</small><br>
                            <small>Message Data: {{ error.messageData|json_encode }}</small>
                        </div>
                    {% endif %}

                    <form action="{{ path('app_login_test') }}" method="post">
                        <div class="mb-3">
                            <label for="username" class="form-label">Username:</label>
                            <input type="text" id="username" name="_username" 
                                   class="form-control" value="{{ last_username }}" 
                                   required autofocus>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password:</label>
                            <input type="password" id="password" name="_password" 
                                   class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Login</button>
                    </form>

                    <div class="mt-4">
                        <h5>Common Authentication Errors:</h5>
                        <ul>
                            <li>Bad credentials - wrong username/password</li>
                            <li>User not found - user provider issue</li>
                            <li>Account disabled - user account is inactive</li>
                            <li>CSRF token invalid - form protection failure</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}