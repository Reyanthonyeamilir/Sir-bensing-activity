{% extends 'base.html.twig' %}

{% block title %}Secure Area{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h1 class="h3 mb-0">Secure Area</h1>
                </div>
                <div class="card-body">
                    <p class="lead">{{ message }}</p>
                    <p>Current user: {{ app.user ? app.user.userIdentifier : 'Not authenticated' }}</p>
                    <p>Roles: {{ app.user ? app.user.roles|join(', ') : 'No roles' }}</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}